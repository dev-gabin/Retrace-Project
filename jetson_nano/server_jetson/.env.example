# Copy to .local/db.env and chmod 600. Do not commit real credentials.
RETRACE_DB_HOST=127.0.0.1
RETRACE_DB_PORT=3306
RETRACE_DB_NAME=retrace
RETRACE_DB_USER=retrace
RETRACE_DB_PASSWORD=retrace
RETRACE_SERVER_PORT=5000
RETRACE_CLIENTS_FILE=jetson_nano/server_jetson/server/idpasswd.txt
# Use an absolute path on Jetson; parent must already exist.
# RETRACE_DATA_DIR=/home/jetson/retrace-data

# Python vision client. Add the same ID/password to RETRACE_CLIENTS_FILE.
RETRACE_VISION_CLIENT_ID=VISION
RETRACE_VISION_CLIENT_PASSWORD=CHANGE_ME
RETRACE_SERVER_HOST=127.0.0.1

# STM32 main unit and camera-to-servo calibration (degrees).
RETRACE_STM32_PORT=/dev/ttyACM0
RETRACE_PAN_LEFT=135
RETRACE_PAN_RIGHT=45
RETRACE_TILT_TOP=60
RETRACE_TILT_BOTTOM=120
